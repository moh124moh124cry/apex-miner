{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apxn-miner-live",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker/index.js",
  "triggers": {
    "crons": [
      "0 */2 * * *"
    ]
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}

